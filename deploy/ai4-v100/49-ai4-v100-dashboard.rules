polkit.addRule(function(action, subject) {
    if (subject.user !== "ai" || action.id !== "org.freedesktop.systemd1.manage-units")
        return;

    var units = [
        "comfyui.service",
        "unsloth.service",
        "3dgenstudio.service",
        "3dgenstudio-meshtools.service",
        "3dgenstudio-rigging.service"
    ];
    var verbs = ["start", "stop", "restart"];
    if (units.indexOf(action.lookup("unit")) !== -1 &&
        verbs.indexOf(action.lookup("verb")) !== -1)
        return polkit.Result.YES;
});
