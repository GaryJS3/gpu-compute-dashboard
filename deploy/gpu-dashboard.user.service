[Unit]
Description=VectorGPU local compute dashboard

[Service]
Type=simple
WorkingDirectory=%h/.local/share/gpu-dashboard
ExecStart=/usr/bin/dotnet %h/.local/share/gpu-dashboard/GpuComputeDashboard.dll
Environment=ASPNETCORE_ENVIRONMENT=Production
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
