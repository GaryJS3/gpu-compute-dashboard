[Unit]
Description=VectorGPU local compute dashboard
After=default.target

[Service]
Type=simple
WorkingDirectory=/opt/gpu-dashboard
ExecStart=/usr/bin/dotnet /opt/gpu-dashboard/GpuComputeDashboard.dll
Environment=ASPNETCORE_ENVIRONMENT=Production
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true

[Install]
WantedBy=default.target
