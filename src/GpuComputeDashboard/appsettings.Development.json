{
  "Dashboard": {
    "NodeName": "demo-v100",
    "GpuLabel": "NVIDIA Tesla V100 32 GB",
    "OsLabel": "Ubuntu 24.04",
    "DemoMode": true,
    "EnableServiceControls": false,
    "PollSeconds": 5,
    "Mounts": [
      {
        "Path": "/mnt/ai-share",
        "Source": "nfs.example:/models"
      }
    ],
    "Workloads": [
      {
        "Id": "studio",
        "Name": "3D Gen Studio",
        "Unit": "3dgenstudio.service",
        "Scope": "system",
        "Category": "3D Generation",
        "Description": "Main 3D generation interface",
        "Port": 3001
      },
      {
        "Id": "comfy",
        "Name": "ComfyUI",
        "Unit": "comfyui.service",
        "Scope": "system",
        "Category": "Image Generation",
        "Description": "ComfyUI workflows and custom nodes",
        "Port": 8188
      },
      {
        "Id": "mesh",
        "Name": "Mesh Tools",
        "Unit": "mesh-tools.service",
        "Scope": "system",
        "Category": "3D Generation",
        "Description": "Mesh processing and export",
        "Port": 8200
      },
      {
        "Id": "rig",
        "Name": "SkinTokens / AutoRig",
        "Unit": "autorig.service",
        "Scope": "system",
        "Category": "3D Generation",
        "Description": "Automatic skeleton and skin weights",
        "Port": 8300
      },
      {
        "Id": "unsloth",
        "Name": "Unsloth Studio",
        "Unit": "unsloth.service",
        "Scope": "system",
        "Category": "Training",
        "Description": "Model training and inference workspace",
        "Port": 8889
      },
      {
        "Id": "llama",
        "Name": "Llama Monitor",
        "Unit": "llama-monitor.service",
        "Scope": "user",
        "Category": "LLM Inference",
        "Description": "Manages llama.cpp instances and presets",
        "Port": 7778
      }
    ]
  }
}
