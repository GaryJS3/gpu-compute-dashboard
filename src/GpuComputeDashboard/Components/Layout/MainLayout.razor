@inherits LayoutComponentBase
@inject IOptions<DashboardOptions> Configuration

@if (Configuration.Value.DemoMode)
{
    <div class="demo-bar"><b>DEMO MODE</b><span>Sample telemetry and simulated controls</span></div>
}
<div class="shell">
    <aside class="sidebar">
        <a class="logo" href="/">
            <span class="brandmark" aria-hidden="true">⬡</span>
            <div><strong>Vector<span>GPU</span></strong><small>@Configuration.Value.NodeName</small></div>
        </a>
        <nav aria-label="Main navigation">
            <NavLink href="/" Match="NavLinkMatch.All"><span class="nav-icon" aria-hidden="true">▦</span> Overview</NavLink>
            <NavLink href="/gpu"><span class="nav-icon" aria-hidden="true">◈</span> GPU</NavLink>
            <NavLink href="/applications"><span class="nav-icon" aria-hidden="true">⬡</span> Applications</NavLink>
            <NavLink href="/workloads"><span class="nav-icon" aria-hidden="true">▤</span> Workloads</NavLink>
            <NavLink href="/journal"><span class="nav-icon" aria-hidden="true">☰</span> Journal</NavLink>
            <NavLink href="/storage"><span class="nav-icon" aria-hidden="true">▥</span> Storage</NavLink>
            <NavLink href="/settings"><span class="nav-icon" aria-hidden="true">⚙</span> Settings</NavLink>
        </nav>
    </aside>
    <main class="content">@Body</main>
</div>
