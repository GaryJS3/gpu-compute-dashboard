@page "/gpu"
@inherits LivePage
@inject TelemetryMonitor Telemetry
@inject WorkloadManager Manager

<PageTitle>GPU Analytics · VectorGPU</PageTitle>
@{ var gpu = Telemetry.Current.Gpu; }
<div class="page-head"><div><h1>GPU</h1><p>@(gpu?.Name ?? Manager.Options.GpuLabel)</p></div></div>
@if (gpu is null) { <div class="notice warning-box">No supported GPU has been detected. Check driver installation and whether nvidia-smi or rocm-smi is accessible to the dashboard service account.</div> }
<div class="metric-grid">
    <article class="metric-card blue"><div class="metric-heading">GPU UTILIZATION</div><div class="metric-value">@Fmt(gpu?.Utilization, "%")</div><ResourceBar Percent="gpu?.Utilization" /></article>
    <article class="metric-card purple"><div class="metric-heading">VRAM USED</div><div class="metric-value">@Fmt(gpu?.MemoryUsedGb)<small> / @Fmt(gpu?.MemoryTotalGb, " GiB")</small></div><ResourceBar Percent="gpu?.MemoryPercent" Tone="purple" /></article>
    <article class="metric-card orange"><div class="metric-heading">TEMPERATURE</div><div class="metric-value">@Fmt(gpu?.TemperatureC, "°C")</div></article>
    <article class="metric-card teal"><div class="metric-heading">POWER</div><div class="metric-value">@Fmt(gpu?.PowerWatts, " W")</div></article>
</div>
<div class="primary-grid gpu-grid">
    <section class="panel"><div class="panel-heading"><div><h2>GPU utilization history</h2></div></div><GpuChart Points="Telemetry.History" /></section>
    <section class="panel"><div class="panel-heading"><div><h2>Hardware information</h2></div></div>
        <div class="info-line"><span>Device</span><b>@(gpu?.Name ?? Manager.Options.GpuLabel)</b></div>
        <div class="info-line"><span>Vendor</span><b>@(gpu?.Vendor ?? "—")</b></div>
        <div class="info-line"><span>Driver</span><b>@(gpu?.Driver ?? "—")</b></div>
        <div class="info-line"><span>Core clock</span><b>@Fmt(gpu?.CoreMhz, " MHz")</b></div>
        <div class="info-line"><span>Memory clock</span><b>@Fmt(gpu?.MemoryMhz, " MHz")</b></div>
        <div class="info-line"><span>Backend</span><b>@(gpu?.Backend ?? "—")</b></div>
        @if (!string.IsNullOrWhiteSpace(gpu?.Error)) { <p class="small-muted">@gpu.Error</p> }
    </section>
</div>
<section class="panel">
    <div class="panel-heading"><div><h2>GPU compute processes</h2><p>VRAM reported by NVIDIA for this GPU</p></div></div>
    @if (gpu?.ComputeProcesses is not { } processes)
    {
        <div class="panel-foot">Process readings are unavailable.</div>
    }
    else if (processes.Count == 0)
    {
        <div class="panel-foot">The driver reported no active compute processes.</div>
    }
    else
    {
        <div class="table-scroll"><table>
            <thead><tr><th>WORKLOAD</th><th>PROCESS</th><th>PID</th><th>VRAM</th></tr></thead>
            <tbody>
            @foreach (var process in processes.OrderByDescending(process => process.MemoryMiB))
            {
                var owner = workloads.Where(workload => workload.Owns(process))
                    .MaxBy(workload => workload.ControlGroup?.Length);
                <tr>
                    <td>@(owner?.Name ?? "Unattributed")</td>
                    <td class="mono">@process.Name</td><td>@process.Pid</td>
                    <td>@(process.MemoryMiB is long mib ? $"{mib:N0} MiB" : "—")</td>
                </tr>
            }
            </tbody>
        </table></div>
        <div class="panel-foot">Compute processes only. Graphics and driver allocations can contribute to the GPU total.</div>
    }
</section>
@code {
    private IReadOnlyList<WorkloadState> workloads = [];
    protected override async Task RefreshAsync() =>
        workloads = Telemetry.Current.Gpu?.ComputeProcesses is { Count: > 0 } ? await Manager.GetAllAsync() : [];

    private static string Fmt(double? n, string suffix = "") => n is null ? "—" : n.Value.ToString("0.#") + suffix;
}
