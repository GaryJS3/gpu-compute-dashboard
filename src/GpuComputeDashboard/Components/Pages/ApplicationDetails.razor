@page "/applications/{Id}"
@inherits LivePage
@inject WorkloadManager Manager
@inject TelemetryMonitor Telemetry

<PageTitle>@(item?.Name ?? "Application") · VectorGPU</PageTitle>
<a href="@(item?.ShowInApplications == false ? "/workloads" : "/applications")" class="text-link back-link">← @(item?.ShowInApplications == false ? "Workloads" : "Applications")</a>

@if (item is { } service)
{
    <div class="page-head">
        <div>
            <h1>@service.Name</h1>
            <p>@service.Description</p>
        </div>
        <div class="head-buttons">
            @if (service.LaunchUrl is { } url)
            {
                <a class="button primary" href="@url" target="_blank" rel="noopener noreferrer">Open app ↗</a>
            }
            @if (CanControl)
            {
                var actionDisabled = busy || pending is not null || service.Error is not null;
                @if (service.Running)
                {
                    <button class="button danger" disabled="@actionDisabled" @onclick='() => pending = "stop"'>Stop service</button>
                }
                else
                {
                    <button class="button secondary" disabled="@actionDisabled" @onclick='() => pending = "start"'>Start service</button>
                }
            }
        </div>
    </div>

    @if (pending is { } action)
    {
        <div class="confirm">
            <span>Confirm <b>@action</b> on <b>@service.Name</b>?</span>
            <button class="button danger" @onclick="ApplyAsync">Confirm</button>
            <button class="button secondary" @onclick="() => pending = null">Cancel</button>
        </div>
    }
    @if (notice is not null)
    {
        <div class="notice" role="status">@notice</div>
    }

    <div class="primary-grid gpu-grid">
        <section class="panel padded">
            <h2>Service status</h2>
            <div class="info-line"><span>State</span><ServiceBadge Service="service" /></div>
            <div class="info-line"><span>Systemd unit</span><b class="mono">@service.Unit</b></div>
            <div class="info-line"><span>Scope</span><b>@service.Scope</b></div>
            <div class="info-line"><span>Main PID</span><b>@(service.Pid?.ToString() ?? "—")</b></div>
            @if (service.Port is int port)
            {
                <div class="info-line"><span>Port</span><b>@port</b></div>
            }
            @if (!string.IsNullOrWhiteSpace(service.Path))
            {
                <div class="info-line"><span>Working directory</span><b class="mono">@service.Path</b></div>
            }
            @if (service.Error is not null)
            {
                <p class="muted">@service.Error</p>
            }
        </section>
        <section class="panel padded">
            <h2>Service resources</h2>
            <div class="info-line"><span>RAM</span><b>@(service.MemoryMb is double memory ? $"{memory:0} MiB" : "—")</b></div>
            <div class="info-line"><span>CPU time since start</span><b>@(service.CpuTime is TimeSpan cpu ? $"{cpu.TotalSeconds:0.0} s" : "—")</b></div>
            <div class="info-line"><span>Tasks</span><b>@(service.Tasks?.ToString() ?? "—")</b></div>
            <div class="info-line"><span>Compute VRAM</span><b>@(service.ComputeVramMiB(Telemetry.Current.Gpu?.ComputeProcesses) is long mib ? $"{mib:N0} MiB" : "—")</b></div>
            <p class="small-muted">Compute VRAM comes from matched NVIDIA processes.</p>
        </section>
    </div>

    @if (supportingServices.Length > 0)
    {
        <section class="panel supporting-services">
            <div class="panel-heading"><h2>Supporting services</h2></div>
            @foreach (var support in supportingServices)
            {
                <details class="supporting-service" @key="support.Id">
                    <summary>
                        <span><strong>@support.Name</strong><small class="mono">@support.Unit</small></span>
                        <ServiceBadge Service="support" />
                    </summary>
                    @if (support.Error is not null)
                    {
                        <p class="small-muted padded">@support.Error</p>
                    }
                    <ServiceJournal WorkloadId="@support.Id" LogLabel="@($"Recent logs for {support.Name}")" />
                </details>
            }
        </section>
    }

    <ServiceJournal @key="service.Id" WorkloadId="@service.Id" @ref="mainJournal" />
}
else if (resolvedId == Id)
{
    <div class="notice">No registered application matches this address.</div>
}
else
{
    <p class="muted" role="status">Loading service…</p>
}

@code {
    [Parameter] public string Id { get; set; } = "";

    private WorkloadState? item;
    private string? loadedId, resolvedId, pending, notice;
    private WorkloadState[] supportingServices = [];
    private ServiceJournal? mainJournal;
    private bool busy;
    private bool CanControl => Manager.Options.DemoMode || Manager.Options.EnableServiceControls;

    protected override async Task OnParametersSetAsync()
    {
        if (loadedId == Id) return;
        loadedId = Id;
        pending = notice = null;
        busy = false;
        if (item?.Id != Id)
        {
            item = null;
            resolvedId = null;
            supportingServices = [];
            await RefreshAsync();
        }
    }

    protected override async Task RefreshAsync()
    {
        var id = Id;
        var definition = Manager.Options.Workloads.FirstOrDefault(workload => workload.Id == id);
        var supportingIds = definition?.SupportingWorkloadIds.Where(supportId => supportId != id).Distinct() ?? [];
        var serviceTask = Manager.GetAsync(id);
        var supportTask = Task.WhenAll(supportingIds.Select(supportId => Manager.GetAsync(supportId)));
        var service = await serviceTask;
        var support = await supportTask;
        await InvokeAsync(() =>
        {
            if (id != Id) return;
            item = service;
            resolvedId = id;
            supportingServices = support.OfType<WorkloadState>().ToArray();
        });
    }

    private async Task ApplyAsync()
    {
        if (busy || pending is not { } action || item is not { } service) return;
        pending = null;
        busy = true;
        notice = $"{action} in progress…";
        var result = await Manager.ControlAsync(service.Id, action);
        if (service.Id != Id) return;
        notice = result.Message;
        busy = false;
        await RefreshAsync();
        if (service.Id == Id && mainJournal is not null)
            await mainJournal.RefreshAsync();
    }
}
