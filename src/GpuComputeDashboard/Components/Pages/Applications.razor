@page "/applications"
@inherits LivePage
@inject WorkloadManager Manager

<PageTitle>Applications · VectorGPU</PageTitle>
<div class="page-head"><h1>Applications</h1></div>
@if (!services.Any(item => item.ShowInApplications))
{
    <p class="muted">No applications registered.</p>
}
<div class="application-grid">
    @foreach (var item in services.Where(item => item.ShowInApplications))
    {
        <article class="panel app-card" @key="item.Id">
            <div class="app-card-top">
                <h2><a href="@item.DetailsPath">@item.Name</a></h2>
                <ServiceBadge Service="item" />
            </div>
            <p>@item.Description</p>
            <div class="app-card-actions">
                <a class="button secondary" href="@item.DetailsPath" aria-label="@($"Details for {item.Name}")">Details</a>
                @if (item.LaunchUrl is { } url)
                {
                    <a class="button primary" target="_blank" rel="noopener noreferrer" href="@url" aria-label="@($"Open {item.Name}")">Open app ↗</a>
                }
            </div>
        </article>
    }
</div>

@code {
    private IReadOnlyList<WorkloadState> services = [];
    protected override async Task RefreshAsync() => services = await Manager.GetAllAsync();
}
