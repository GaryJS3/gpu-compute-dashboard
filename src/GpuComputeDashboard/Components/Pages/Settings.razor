@page "/settings"
@inject WorkloadManager Manager
@inject IConfiguration Configuration

<PageTitle>Settings · VectorGPU</PageTitle>
<div class="page-head"><div><h1>Settings</h1><p>Restart the dashboard after changing its configuration files.</p></div></div>
<div class="primary-grid gpu-grid">
    <section class="panel"><div class="panel-heading"><div><h2>Runtime</h2><p>Dashboard configuration</p></div></div>
        <div class="settings-list"><div class="info-line"><span>Node name</span><b>@Manager.Options.NodeName</b></div>
        <div class="info-line"><span>GPU label</span><b>@Manager.Options.GpuLabel</b></div>
        <div class="info-line"><span>Demo mode</span><b>@Manager.Options.DemoMode</b></div>
        <div class="info-line"><span>Service controls</span><b>@Manager.Options.EnableServiceControls</b></div>
        <div class="info-line"><span>Sample interval</span><b>@Manager.Options.PollSeconds seconds</b></div>
        <div class="info-line"><span>Registered services</span><b>@Manager.Options.Workloads.Count</b></div></div>
    </section>
    <section class="panel"><div class="panel-heading"><h2>Access</h2></div>
        <div class="info-line"><span>Dashboard access</span><b>@AccessMode</b></div>
        @if (AccessMode != "Local only" && Configuration["DashboardAccess:AllowedNetwork"] is { } network)
        {
            <div class="info-line"><span>Allowed subnet</span><b class="mono">@network</b></div>
        }
    </section>
</div>
<div class="panel"><div class="panel-heading"><h2>Registered units</h2></div>
<div class="table-scroll"><table><thead><tr><th>APPLICATION</th><th>UNIT</th><th>SCOPE</th><th>PORT</th></tr></thead><tbody>
@foreach (var w in Manager.Options.Workloads) { <tr><td>@w.Name</td><td class="mono">@w.Unit</td><td>@w.Scope</td><td>@w.Port</td></tr> }
</tbody></table></div></div>

@code {
    private string AccessMode => Configuration.GetValue<bool>("DashboardAccess:Enabled") ? "HTTPS with login"
        : Configuration.GetValue<bool>("DashboardAccess:AllowUnauthenticatedLan") ? "HTTPS without login"
        : "Local only";
}
