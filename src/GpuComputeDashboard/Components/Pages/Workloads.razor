@page "/workloads"
@inherits LivePage
@inject WorkloadManager Manager
@inject TelemetryMonitor Telemetry

<PageTitle>Workloads · VectorGPU</PageTitle>
<div class="page-head">
    <div>
        <h1>Workloads</h1>
        <p>@items.Count(item => item.Running) of @items.Count running@(Manager.Options.DemoMode ? " · Simulated controls" : CanControl ? "" : " · Read-only")</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(notice))
{
    <div class="notice" role="status">@notice</div>
}
@if (pending is { } operation)
{
    <div class="confirm">
        <span>Confirm <b>@operation.Action</b> on <b>@operation.Name</b>?</span>
        <button class="button @(operation.Action == "stop" ? "danger" : "primary")" @onclick="Execute">Confirm</button>
        <button class="button secondary" @onclick="() => pending = null">Cancel</button>
    </div>
}
@{
    var visibleItems = Filtered.ToArray();
    var processes = Telemetry.Current.Gpu?.ComputeProcesses;
}
<div class="panel">
    <div class="table-toolbar">
        <input type="search" class="search-box" placeholder="Filter by service, unit, or category" aria-label="Filter workloads" @bind="search" @bind:event="oninput" />
        <div class="toggle-group" role="group" aria-label="Workload status">
            <button class="@(filter == "all" ? "selected" : "")" aria-pressed="@(filter == "all" ? "true" : "false")" @onclick='() => filter = "all"'>All</button>
            <button class="@(filter == "running" ? "selected" : "")" aria-pressed="@(filter == "running" ? "true" : "false")" @onclick='() => filter = "running"'>Running</button>
            <button class="@(filter == "stopped" ? "selected" : "")" aria-pressed="@(filter == "stopped" ? "true" : "false")" @onclick='() => filter = "stopped"'>Inactive</button>
        </div>
    </div>
    @if (visibleItems.Length == 0)
    {
        <p class="muted padded">@(items.Count == 0 ? "No workloads registered." : "No workloads match these filters.")</p>
    }
    else
    {
        <div class="table-scroll" tabindex="0" role="region" aria-label="Registered workloads">
            <table class="workload-table">
                <thead><tr><th>Service</th><th>Status</th><th>RAM</th><th>Compute VRAM</th>@if (CanControl) { <th class="align-right">Actions</th> }</tr></thead>
                <tbody>
                @foreach (var item in visibleItems)
                {
                    var canAct = !busy && pending is null && item.Error is null;
                    <tr @key="item.Id">
                        <td><a class="workload-name" href="@item.DetailsPath">@item.Name</a><div class="small-muted mono">@item.Unit</div></td>
                        <td>
                            <ServiceBadge Service="item" />
                            @if (item.Error is not null) { <div class="small-muted">See service details</div> }
                        </td>
                        <td>@(item.MemoryMb is double memory ? $"{memory:N0} MiB" : "—")</td>
                        <td>@(item.ComputeVramMiB(processes) is long mib ? $"{mib:N0} MiB" : "—")</td>
                        @if (CanControl)
                        {
                            <td><div class="action-group">
                                @if (item.Running)
                                {
                                    <button class="mini-button" disabled="@(!canAct)" @onclick='() => Ask(item, "restart")'>Restart</button>
                                    <button class="mini-button danger-text" disabled="@(!canAct)" @onclick='() => Ask(item, "stop")'>Stop</button>
                                }
                                else
                                {
                                    <button class="mini-button" disabled="@(!canAct)" @onclick='() => Ask(item, "start")'>Start</button>
                                }
                            </div></td>
                        }
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="panel-foot">Compute VRAM comes from matched NVIDIA processes. A dash means no reading.</div>
    }
</div>

@code {
    private IReadOnlyList<WorkloadState> items = [];
    private string search = "", filter = "all", notice = "";
    private (string Id, string Name, string Action)? pending;
    private bool busy;
    private bool CanControl => Manager.Options.DemoMode || Manager.Options.EnableServiceControls;

    private IEnumerable<WorkloadState> Filtered => items.Where(item =>
        (filter == "all" || (filter == "running" ? item.Running : !item.Running)) &&
        (item.Name.Contains(search, StringComparison.OrdinalIgnoreCase) ||
         item.Unit.Contains(search, StringComparison.OrdinalIgnoreCase) ||
         item.Category.Contains(search, StringComparison.OrdinalIgnoreCase)));

    protected override async Task RefreshAsync() => items = await Manager.GetAllAsync();

    private void Ask(WorkloadState item, string action)
    {
        if (busy || pending is not null) return;
        pending = (item.Id, item.Name, action);
        notice = "";
    }

    private async Task Execute()
    {
        if (busy || pending is not { } operation) return;
        pending = null;
        busy = true;
        notice = $"Applying {operation.Action} to {operation.Name}…";
        try
        {
            var result = await Manager.ControlAsync(operation.Id, operation.Action);
            notice = result.Message;
            await RefreshAsync();
        }
        finally
        {
            busy = false;
        }
    }
}
