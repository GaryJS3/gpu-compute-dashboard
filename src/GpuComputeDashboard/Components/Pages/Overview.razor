@page "/"
@inherits LivePage
@inject TelemetryMonitor Telemetry
@inject WorkloadManager Manager

<PageTitle>Overview · VectorGPU</PageTitle>
@{
    var reading = Telemetry.Current;
    var gpu = reading.Gpu;
    var host = reading.Host;
    var running = workloads.Count(x => x.Running);
    var mounts = Manager.GetMounts();
}
<div class="page-head"><div>
    <div class="eyebrow"><span class="blue-dot"></span> NODE OVERVIEW <span class="sep">/</span> @Manager.Options.GpuLabel</div>
    <h1>Compute command center<span class="accent">.</span></h1>
    <p>GPU activity, service health, and infrastructure on @Manager.Options.NodeName.</p>
</div><div class="head-buttons"><a href="/journal" class="button secondary">☰ View logs</a><a href="/workloads" class="button primary">Manage workloads ↗</a></div></div>

<div class="summary-strip">
    <div><span class="status-indicator"></span><b>@workloads.Count services registered</b><small>@running running</small></div>
    <div><span class="summary-icon">◈</span><b>@(gpu?.Name ?? "GPU not detected")</b><small>@(gpu?.Backend ?? "No supported GPU telemetry")</small></div>
    <div><span class="summary-icon">◷</span><b>@((int)host.Uptime.TotalDays)d @host.Uptime.Hours.ToString("00")h</b><small>Host uptime</small></div>
    <div><span class="@(mounts.All(x => x.Mounted) ? "status-indicator" : "status-indicator warning")"></span><b>@mounts.Count(x => x.Mounted)/@mounts.Count mounts connected</b><small>Configured external storage</small></div>
</div>

<div class="metric-grid">
    <article class="metric-card blue"><div class="metric-heading">GPU UTILIZATION <span>◈</span></div><div class="metric-value">@Fmt(gpu?.Utilization, "%")</div><div class="metric-note">Current GPU load</div><ResourceBar Percent="gpu?.Utilization" Tone="blue" /></article>
    <article class="metric-card purple"><div class="metric-heading">VRAM ALLOCATED <span>▥</span></div><div class="metric-value">@Fmt(gpu?.MemoryUsedGb)<small> / @Fmt(gpu?.MemoryTotalGb, " GB")</small></div><div class="metric-note">@Fmt(gpu?.MemoryPercent, "%") of GPU memory</div><ResourceBar Percent="gpu?.MemoryPercent" Tone="purple" /></article>
    <article class="metric-card orange"><div class="metric-heading">GPU TEMPERATURE <span>♧</span></div><div class="metric-value">@Fmt(gpu?.TemperatureC, "°C")</div><div class="metric-note">Driver-reported sensor</div><ResourceBar Percent="gpu?.TemperatureC" Tone="orange" /></article>
    <article class="metric-card teal"><div class="metric-heading">BOARD POWER <span>ϟ</span></div><div class="metric-value">@Fmt(gpu?.PowerWatts, " W")</div><div class="metric-note">GPU reported power draw</div><ResourceBar Percent="gpu?.PowerWatts is double w ? w / 300 * 100 : null" Tone="teal" /></article>
</div>

<div class="primary-grid">
    <section class="panel"><div class="panel-heading"><div><h2>GPU activity <span class="subtle">GPU 0</span></h2><p>Recent telemetry · @Telemetry.History.Count samples</p></div><a class="text-link" href="/gpu">GPU details ↗</a></div>
        <div class="chart-current">GPU <b>@Fmt(gpu?.Utilization, "%")</b> <span>·</span> VRAM <b>@Fmt(gpu?.MemoryUsedGb, " GB")</b></div>
        <GpuChart Points="Telemetry.History" />
    </section>
    <section class="panel"><div class="panel-heading"><div><h2>Active workloads <span class="subtle">@running / @workloads.Count</span></h2><p>Registered systemd units</p></div><a href="/workloads" class="text-link">View all ↗</a></div>
        <div class="service-list">
            @foreach (var item in workloads.Take(7))
            {
                <div class="service-row"><span class="status-indicator @(item.Running ? "" : "warning")"></span><div class="service-title"><strong>@item.Name</strong><small>@item.Category</small></div><span class="service-state @(item.Running ? "healthy" : "")">@item.State</span><a class="icon-button" href="/workloads" title="Inspect workload">↗</a></div>
            }
        </div>
        <div class="panel-foot"><span>@(running == workloads.Count && running > 0 ? "All registered workloads running" : "Review inactive or missing services")</span><a href="/applications" class="text-link">Applications ↗</a></div>
    </section>
</div>

<div class="secondary-grid">
    <section class="panel"><div class="panel-heading"><div><h2>System resources</h2><p>@host.OsDescription</p></div></div>
        <div class="resource-line"><div><span>CPU <small>@host.CpuCount vCPU</small></span><b>@Fmt(host.CpuPercent, "%")</b></div><ResourceBar Percent="host.CpuPercent" /></div>
        <div class="resource-line"><div><span>Memory <small>@Fmt(host.MemoryUsedGb) / @Fmt(host.MemoryTotalGb, " GB")</small></span><b>@Fmt(host.MemoryPercent, "%")</b></div><ResourceBar Percent="host.MemoryPercent" Tone="purple" /></div>
        <div class="resource-line"><div><span>Root filesystem <small>@Fmt(host.DiskUsedGb) / @Fmt(host.DiskTotalGb, " GB")</small></span><b>@Fmt(host.DiskPercent, "%")</b></div><ResourceBar Percent="host.DiskPercent" Tone="teal" /></div>
    </section>
    <section class="panel"><div class="panel-heading"><div><h2>Infrastructure</h2><p>Compute dependencies</p></div><a href="/storage" class="text-link">Inspect ↗</a></div>
        @foreach (var mount in mounts)
        {
            <div class="health-row"><span class="health-icon">▥</span><div><strong>@mount.Path</strong><small>@mount.ExpectedSource</small></div><span class="service-state @(mount.Mounted ? "healthy" : "")">@(mount.Mounted ? "Mounted" : "Missing")</span></div>
        }
        <div class="health-row"><span class="health-icon">◈</span><div><strong>GPU Driver</strong><small>@(gpu?.Driver ?? "Not detected")</small></div><span class="service-state @(gpu is not null ? "healthy" : "")">@(gpu is not null ? "Available" : "Unavailable")</span></div>
    </section>
    <section class="panel"><div class="panel-heading"><div><h2>Node status</h2><p>Source and refresh details</p></div></div>
        <div class="info-line"><span>Hostname</span><b>@host.Hostname</b></div>
        <div class="info-line"><span>Telemetry</span><b>@(reading.IsDemo ? "Demo / simulated" : "Local / live")</b></div>
        <div class="info-line"><span>Last sample</span><b>@(reading.Timestamp == DateTimeOffset.MinValue ? "Waiting…" : reading.Timestamp.ToLocalTime().ToString("HH:mm:ss"))</b></div>
        <div class="info-line"><span>Service controls</span><b>@(Manager.Options.DemoMode ? "Simulated" : Manager.Options.EnableServiceControls ? "Enabled" : "Disabled")</b></div>
    </section>
</div>

@code {
    private IReadOnlyList<WorkloadState> workloads = [];
    protected override async Task RefreshAsync() => workloads = await Manager.GetAllAsync();
    private static string Fmt(double? n, string suffix = "") => n is null ? "—" : n.Value.ToString("0.#") + suffix;
}
