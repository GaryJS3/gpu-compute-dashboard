@page "/"
@inherits LivePage
@inject TelemetryMonitor Telemetry
@inject WorkloadManager Manager

<PageTitle>Overview · VectorGPU</PageTitle>
@{
    var reading = Telemetry.Current;
    var gpu = reading.Gpu;
    var host = reading.Host;
    var running = workloads.Count(x => x.Running);
    var mounts = Manager.GetMounts();
}
<div class="page-head">
    <div>
        <h1>Overview</h1>
        <p>@(gpu?.Name ?? Manager.Options.GpuLabel) · Uptime @((int)host.Uptime.TotalDays)d @host.Uptime.Hours.ToString("00")h</p>
    </div>
</div>

<div class="metric-grid">
    <article class="metric-card blue"><div class="metric-heading">GPU load</div><div class="metric-value">@Fmt(gpu?.Utilization, "%")</div><ResourceBar Percent="gpu?.Utilization" Tone="blue" /></article>
    <article class="metric-card purple"><div class="metric-heading">VRAM used</div><div class="metric-value">@Fmt(gpu?.MemoryUsedGb)<small> / @Fmt(gpu?.MemoryTotalGb, " GiB")</small></div><ResourceBar Percent="gpu?.MemoryPercent" Tone="purple" /></article>
    <article class="metric-card orange"><div class="metric-heading">GPU temperature</div><div class="metric-value">@Fmt(gpu?.TemperatureC, " °C")</div></article>
    <article class="metric-card teal"><div class="metric-heading">Board power</div><div class="metric-value">@Fmt(gpu?.PowerWatts, " W")</div></article>
</div>

<div class="primary-grid">
    <section class="panel">
        <div class="panel-heading">
            <div><h2>GPU activity</h2><p>Last sample @(reading.Timestamp == DateTimeOffset.MinValue ? "pending" : reading.Timestamp.ToLocalTime().ToString("HH:mm:ss"))</p></div>
            <a class="text-link" href="/gpu">GPU details ↗</a>
        </div>
        <GpuChart Points="Telemetry.History" />
    </section>
    <section class="panel">
        <div class="panel-heading">
            <div><h2>Workloads</h2><p>@running of @workloads.Count running</p></div>
            <a href="/workloads" class="text-link">View all ↗</a>
        </div>
        <div class="service-list">
            @if (workloads.Count == 0)
            {
                <p class="muted">No workloads registered.</p>
            }
            @foreach (var item in workloads.OrderBy(item => item.Running).Take(7))
            {
                <div class="service-row" @key="item.Id">
                    <a href="@item.DetailsPath" class="service-title">@item.Name</a>
                    <ServiceBadge Service="item" />
                </div>
            }
        </div>
    </section>
</div>

<div class="primary-grid">
    <section class="panel">
        <div class="panel-heading"><h2>Host resources</h2></div>
        <div class="resource-line"><div><span>CPU <small>@host.CpuCount vCPU</small></span><b>@Fmt(host.CpuPercent, "%")</b></div><ResourceBar Percent="host.CpuPercent" /></div>
        <div class="resource-line"><div><span>RAM <small>@Fmt(host.MemoryUsedGb) / @Fmt(host.MemoryTotalGb, " GiB")</small></span><b>@Fmt(host.MemoryPercent, "%")</b></div><ResourceBar Percent="host.MemoryPercent" Tone="purple" /></div>
        <div class="resource-line"><div><span>Root disk <small>@Fmt(host.DiskUsedGb) / @Fmt(host.DiskTotalGb, " GiB")</small></span><b>@Fmt(host.DiskPercent, "%")</b></div><ResourceBar Percent="host.DiskPercent" Tone="teal" /></div>
    </section>
    <section class="panel">
        <div class="panel-heading"><h2>Mounts</h2><a href="/storage" class="text-link">Storage ↗</a></div>
        @if (mounts.Count == 0)
        {
            <p class="muted padded">No external mounts configured.</p>
        }
        @foreach (var mount in mounts)
        {
            <div class="info-line"><span class="mono">@mount.Path</span><b class="@(mount.Mounted ? "green-text" : "")">@(mount.Mounted ? "Mounted" : "Check mount")</b></div>
        }
    </section>
</div>

@code {
    private IReadOnlyList<WorkloadState> workloads = [];
    protected override async Task RefreshAsync() => workloads = await Manager.GetAllAsync();
    private static string Fmt(double? n, string suffix = "") => n is null ? "—" : n.Value.ToString("0.#") + suffix;
}
