@page "/storage"
@inherits LivePage
@inject WorkloadManager Manager
@inject TelemetryMonitor Telemetry

<PageTitle>Storage · VectorGPU</PageTitle>
<div class="page-head"><h1>Storage</h1></div>
<div class="primary-grid gpu-grid">
    <section class="panel"><div class="panel-heading"><div><h2>Configured mounts</h2></div></div>
        @if (mounts.Count == 0) { <p class="muted padded">No external mounts configured.</p> }
        @foreach (var mount in mounts)
        {
            <div class="mount-card"><div class="mount-title"><strong>@mount.Path</strong><span class="state-tag @(mount.Mounted ? "up" : "missing")"><span class="status-indicator @(mount.Mounted ? "" : "warning")"></span>@(mount.Mounted ? "Mounted" : mount.ActualSource is null ? "Not mounted" : "Source mismatch")</span></div>
                <div class="info-line"><span>Source</span><b class="mono">@(mount.ActualSource ?? "Not present")</b></div>
                @if (!mount.Mounted && mount.ExpectedSource is not null)
                {
                    <div class="info-line"><span>Expected source</span><b class="mono">@mount.ExpectedSource</b></div>
                }
                <div class="info-line"><span>Filesystem</span><b>@(mount.Filesystem ?? "—")</b></div></div>
        }
    </section>
    <section class="panel"><div class="panel-heading"><div><h2>Root filesystem</h2></div></div>
        <div class="storage-metric"><strong>@Fmt(Telemetry.Current.Host.DiskUsedGb) GiB</strong><span>used of @Fmt(Telemetry.Current.Host.DiskTotalGb) GiB</span></div>
        <ResourceBar Percent="Telemetry.Current.Host.DiskPercent" Tone="blue" />
    </section>
</div>
@code {
    private IReadOnlyList<MountState> mounts = [];
    protected override Task RefreshAsync() { mounts = Manager.GetMounts(); return Task.CompletedTask; }
    private static string Fmt(double? value) => value?.ToString("0.#") ?? "—";
}
